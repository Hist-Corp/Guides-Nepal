# =============================================================================
# Guides Nepal — Frontend Production Environment (Vercel)
# Copy to frontend/.env.production or set these in the Vercel project settings.
# Replace every placeholder (YOUR_*_HERE) with the actual value at deploy time.
# Never commit real secrets to this file.
# =============================================================================

# Public API base URL — must match your deployed Render backend (HTTPS).
# Example: https://guides-nepal.onrender.com/api/v1
VITE_API_URL=https://YOUR_BACKEND_RENDER_URL_HERE/api/v1

# Public base path (Vercel serves from root by default).
VITE_PUBLIC_BASE_URL=/

# Feature flags
VITE_ENABLE_AI=true
VITE_ENABLE_BETA_DASHBOARD=false

# OAuth redirect URLs (must match the OAuth provider console exactly).
# These point to your deployed backend.
VITE_GOOGLE_OAUTH_URL=https://YOUR_BACKEND_RENDER_URL_HERE/api/v1/auth/oauth/google/start
VITE_FACEBOOK_OAUTH_URL=https://YOUR_BACKEND_RENDER_URL_HERE/api/v1/auth/oauth/facebook/start

# Where the browser should land after OAuth completes on the frontend.
FRONTEND_OAUTH_REDIRECT=https://YOUR_FRONTEND_VERCEL_URL_HERE/auth/callback

# Optional Supabase client config (if the frontend calls Supabase directly).
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Optional error-monitoring endpoint (Sentry-compatible JSON via sendBeacon).
# Leave unset to log errors to the browser console only.
# VITE_ERROR_ENDPOINT=https://YOUR_ERROR_COLLECTOR_HERE/api/errors