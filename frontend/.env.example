# Frontend environment example for Guides Nepal
# Copy this file to `frontend/.env` or to the repo root if your frontend reads root .env

# API endpoint (development)
# Use relative /api/v1 so the Vite dev proxy (vite.config.ts -> localhost:8000)
# handles API calls and avoids CORS issues. Do NOT set an absolute
# http://localhost:8000 here for local dev.
VITE_API_URL=/api/v1

# OAuth (development)
FRONTEND_OAUTH_REDIRECT=http://localhost:5175/auth/callback
VITE_GOOGLE_OAUTH_URL=http://localhost:8000/api/v1/auth/oauth/google/start
VITE_FACEBOOK_OAUTH_URL=http://localhost:8000/api/v1/auth/oauth/facebook/start

# Optional overrides
VITE_PUBLIC_BASE_URL=/

# Feature flags
VITE_ENABLE_AI=true
VITE_ENABLE_BETA_DASHBOARD=false
