{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "guides-nepal-dashboard",
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://guides-nepal-el2f.vercel.app" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "env": {
    "VITE_PUBLIC_BASE_URL": "/",
    "VITE_FRONTEND_URL": "https://guides-nepal-iota.vercel.app",
    "VITE_API_BASE_URL": "https://guides-nepal.onrender.com/api/v1"
  }
}

