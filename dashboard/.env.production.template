# =============================================================================
# Guides Nepal — Dashboard Production Environment (Vercel)
# Copy to dashboard/.env.production or set these in the Vercel project settings.
# Replace every placeholder (YOUR_*_HERE) with the actual value at deploy time.
# Never commit real secrets to this file.
# =============================================================================

# Supabase client configuration (dashboard talks to Supabase directly).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Backend API base URL — must match your deployed Render backend (HTTPS).
# Example: https://guides-nepal.onrender.com/api/v1
VITE_API_BASE_URL=https://YOUR_BACKEND_RENDER_URL_HERE/api/v1

# Public frontend used by the dashboard's live page editor.
VITE_FRONTEND_URL=https://YOUR_FRONTEND_VERCEL_URL_HERE

# Dev-only fake login — MUST be 0 or unset in production.
# VITE_DEV_FAKE_LOGIN=0

# Optional error-monitoring endpoint (Sentry-compatible JSON via sendBeacon).
# Leave unset to log errors to the browser console only.
# VITE_ERROR_ENDPOINT=https://YOUR_ERROR_COLLECTOR_HERE/api/errors