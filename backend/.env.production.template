# =============================================================================
# Guides Nepal — Backend Production Environment (Render)
# Copy to backend/.env.production or set these in the Render dashboard.
# Replace every placeholder (YOUR_*_HERE) with the actual value at deploy time.
# Never commit real secrets to this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENV=production
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Security (REQUIRED)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=YOUR_SECRET_KEY_HERE

# Backend bind address (Render sets PORT automatically; 0.0.0.0 is required).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# -----------------------------------------------------------------------------
# Database (REQUIRED) — Supabase PostgreSQL
# -----------------------------------------------------------------------------
# Use the Supabase POOLED connection string (port 6543) for Render.
# Direct port 5432 often fails from Render due to IPv6 routing.
# Pooled format: postgresql://postgres:<PASSWORD>@<PROJECT_REF>.pooler.supabase.com:6543/postgres?sslmode=require
# URL-encode any special characters in the password (e.g. @ → %40).
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD_HERE@YOUR_PROJECT_REF.pooler.supabase.com:6543/postgres?sslmode=require

# -----------------------------------------------------------------------------
# CORS (REQUIRED in production)
# -----------------------------------------------------------------------------
# Comma-separated HTTPS origins of your deployed frontend + dashboard.
# Non-HTTPS origins (except localhost) cause the backend to refuse to boot.
BACKEND_CORS_ORIGINS=https://YOUR_FRONTEND_VERCEL_URL_HERE,https://YOUR_DASHBOARD_VERCEL_URL_HERE

# -----------------------------------------------------------------------------
# Supabase (required for password-reset email verification)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Where the password-reset link should land the user (HTTPS frontend URL).
# Must be allow-listed in Supabase → Authentication → URL Configuration → Redirect URLs.
RESET_PASSWORD_REDIRECT_URL=https://YOUR_FRONTEND_VERCEL_URL_HERE/reset-password

# -----------------------------------------------------------------------------
# AI (optional)
# -----------------------------------------------------------------------------
AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# -----------------------------------------------------------------------------
# OAuth (optional — social login)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE
GOOGLE_REDIRECT_URI=https://YOUR_BACKEND_RENDER_URL_HERE/api/v1/auth/oauth/google/callback

FACEBOOK_CLIENT_ID=YOUR_FACEBOOK_CLIENT_ID_HERE
FACEBOOK_CLIENT_SECRET=YOUR_FACEBOOK_CLIENT_SECRET_HERE
FACEBOOK_REDIRECT_URI=https://YOUR_BACKEND_RENDER_URL_HERE/api/v1/auth/oauth/facebook/callback

FRONTEND_OAUTH_REDIRECT=https://YOUR_FRONTEND_VERCEL_URL_HERE/auth/callback

# -----------------------------------------------------------------------------
# Uploads / Storage
# -----------------------------------------------------------------------------
UPLOADS_DIR=./uploads

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# -----------------------------------------------------------------------------
# Dev Seeding (MUST be false / unset in production)
# -----------------------------------------------------------------------------
DEV_ALLOW_SEED=false