# Backend environment example for Guides Nepal
# Copy this file to `backend/.env` and fill the values before running the server

# Database — local dev default matches docker-compose.yml (postgres/postgres).
# The backend auto-creates missing tables on startup, so plain `uvicorn` works
# with zero Postgres setup. To actually use Postgres, start it
# (`docker compose up -d db` or your local service) and keep this URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guides_nepal

# Security
SECRET_KEY=replace-with-a-secure-random-string
ENV=development

# App
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — must include frontend (5175) + dashboard (5176) incl. 127.0.0.1
# variants browsers may use. The backend code default already covers these,
# this just makes the example explicit.
BACKEND_CORS_ORIGINS=http://localhost:5175,http://localhost:5176,http://localhost:5174,http://127.0.0.1:5175,http://127.0.0.1:5176

# AI configuration
AI_PROVIDER=auto  # options: auto, ollama, openai
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OPENAI_API_KEY=

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/facebook/callback

# Storage / uploads
UPLOADS_DIR=./uploads
